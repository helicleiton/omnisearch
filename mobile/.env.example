# URL do backend. VAZIO = modo fontes abertas: o app consulta APIs públicas e gratuitas
# direto do aparelho, sem servidor (é assim que roda no GitHub Pages).
# Com backend: emulador Android http://10.0.2.2:3333 | celular físico http://<IP-da-máquina>:3333
EXPO_PUBLIC_API_URL=
# Somente se APP_API_KEY estiver definida no backend (não é segredo: fica embutida no app)
EXPO_PUBLIC_APP_API_KEY=
