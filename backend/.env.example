# ----------------------------------------------------------------------------
# OmniSearch backend - copie para .env e preencha. NUNCA versione o .env.
# ----------------------------------------------------------------------------
PORT=3333
NODE_ENV=development

# true = usa dados simulados (padrão). false = chama as APIs reais abaixo
# (cada provedor ainda cai no mock se a respectiva chave estiver vazia).
USE_MOCKS=true

# Origens permitidas no CORS (separadas por vírgula). Apps nativos não enviam
# Origin, então isto afeta apenas clientes web (ex.: Expo Web).
CORS_ORIGINS=http://localhost:8081

# Rate limit: N requisições por janela (ms) por IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Chave opcional exigida no header x-api-key. Atenção: chaves embutidas em
# apps mobile podem ser extraídas; use autenticação de usuário em produção.
APP_API_KEY=

# --- Provedores externos ----------------------------------------------------
# Have I Been Pwned (pago): https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# CNPJ: BrasilAPI é gratuita e sem chave. ReceitaWS aceita token opcional.
CNPJ_PROVIDER_URL=https://brasilapi.com.br/api/cnpj/v1

# Com USE_MOCKS=false e sem as chaves pagas abaixo, o backend usa fontes
# gratuitas: XposedOrNot (e-mail), BrasilAPI (CNPJ e DDD), DNS do Google (MX).

# Escavador (pago): https://api.escavador.com
ESCAVADOR_API_TOKEN=

# Validação de telefone/operadora (ex.: NumVerify/APILayer)
NUMVERIFY_API_KEY=

# Timeout das chamadas externas (ms)
EXTERNAL_TIMEOUT_MS=8000
